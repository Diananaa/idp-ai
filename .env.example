# ============================================
# IDP - Intelligent Document Processing
# Environment Variables Configuration
# ============================================
#
# Copy this file to .env and update the values
# cp .env.example .env
# Or on Windows: copy .env.example .env
#

# ============================================
# Node Environment
# ============================================
# Options: development, production, test
# Development: synchronize enabled (auto sync schema)
# Production: synchronize disabled (data safe)
NODE_ENV=development

# ============================================
# Database Configuration
# ============================================
# Default values match docker-compose.yml
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=testIDP

# Database Synchronize Override
# WARNING: Only set to true if you really need it!
# In production, synchronize is automatically disabled for safety
# DB_SYNC=true

# ============================================
# JWT Authentication
# ============================================
# Generate a strong secret key for JWT tokens
# You can generate one using: openssl rand -base64 32
# Or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ============================================
# Next.js Configuration
# ============================================
# Next.js will automatically use NODE_ENV
# No additional config needed here

# ============================================
# Notes
# ============================================
# 1. Never commit .env file to git (already in .gitignore)
# 2. Use different values for development and production
# 3. Keep JWT_SECRET secure and never share it
# 4. Database credentials should match your docker-compose.yml or actual database

API_KEY_AI_STUDIO_GOOGLE=ini-contohhhh